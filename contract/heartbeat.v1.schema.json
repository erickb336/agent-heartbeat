{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/erickb336/agent-heartbeat/contract/heartbeat.v1.schema.json",
  "title": "agent-heartbeat message, schema version 1",
  "description": "The only data that leaves the machine. Aggregate counts, coverage and timestamps. No content, names, paths or identifiers. See docs/CONTRACT.md for the receiver rules that JSON Schema cannot express.",
  "oneOf": [
    {
      "$ref": "#/$defs/heartbeat"
    },
    {
      "$ref": "#/$defs/dailyUsage"
    }
  ],
  "$defs": {
    "timestamp": {
      "description": "UTC time with a Z suffix and at most millisecond precision.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "usageDate": {
      "description": "Calendar date in timeZone.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timeZone": {
      "description": "IANA time zone that defines usageDate.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)*$"
    },
    "coverage": {
      "description": "complete: every configured source reported. partial: some configured sources reported, so numbers are a known subtotal (a lower bound). unavailable: no configured source reported, so numbers are null.",
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "tokenCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000000
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "coverage"
      ],
      "properties": {
        "active": {
          "description": "Agents with a running turn now. Agents that wait for the user do not count.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "if": {
        "properties": {
          "coverage": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "active": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "active": {
            "type": "integer"
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "cachedInput",
        "output",
        "total",
        "coverage"
      ],
      "properties": {
        "input": {
          "description": "Processed input tokens. Cached input is included.",
          "$ref": "#/$defs/tokenCount"
        },
        "cachedInput": {
          "description": "The part of input that came from the prompt cache.",
          "$ref": "#/$defs/tokenCount"
        },
        "output": {
          "description": "Output tokens. Reasoning tokens are included.",
          "$ref": "#/$defs/tokenCount"
        },
        "total": {
          "description": "input + output.",
          "$ref": "#/$defs/tokenCount"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        }
      },
      "if": {
        "properties": {
          "coverage": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "input": {
            "type": "null"
          },
          "cachedInput": {
            "type": "null"
          },
          "output": {
            "type": "null"
          },
          "total": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "input": {
            "type": "integer"
          },
          "cachedInput": {
            "type": "integer"
          },
          "output": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      }
    },
    "heartbeat": {
      "description": "A live observation. The receiver uses it for freshness (a lease of ttlSeconds), the active count and today's tokens.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "observedAt",
        "ttlSeconds",
        "usageDate",
        "timeZone",
        "agents",
        "tokens"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "heartbeat"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "ttlSeconds": {
          "description": "How long this heartbeat stays fresh after the receiver accepts it. The receiver treats the tracker as connected while receivedAt + ttlSeconds is in the future, by its own clock. 0 means the tracker stopped cleanly.",
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "usageDate": {
          "$ref": "#/$defs/usageDate"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "agents": {
          "$ref": "#/$defs/agents"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        }
      }
    },
    "dailyUsage": {
      "description": "A correction of one day's token totals. It never changes freshness or the active count.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "type",
        "observedAt",
        "usageDate",
        "timeZone",
        "tokens"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "type": {
          "const": "dailyUsage"
        },
        "observedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "usageDate": {
          "$ref": "#/$defs/usageDate"
        },
        "timeZone": {
          "$ref": "#/$defs/timeZone"
        },
        "tokens": {
          "$ref": "#/$defs/tokens"
        }
      }
    }
  }
}
